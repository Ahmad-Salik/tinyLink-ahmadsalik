<%- include("layout", { title: "TinyLink Dashboard" }) %>

<h1>TinyLink</h1>

<!-- Create Link Form -->
<form id="createForm">
  <h3>Create a New Short Link</h3>

  <label>Long URL:</label>
  <input type="text" id="urlInput" placeholder="https://example.com" required />

  <label>Custom Code (optional):</label>
  <input type="text" id="codeInput" placeholder="abc123" />

  <button type="submit">Create Link</button>

  <p id="formMessage"></p>
</form>

<hr />

<!-- Search -->
<h3>Your Links</h3>
<input type="text" id="searchInput" placeholder="Search by code or URL..." />

<div id="linksContainer">Loading...</div>

<script>
// Load all links
async function loadLinks() {
  const container = document.getElementById("linksContainer");
  container.innerHTML = "Loading...";

  const res = await fetch("/api/links");
  const links = await res.json();

  if (links.length === 0) {
    container.innerHTML = "<p>No links yet. Create your first one!</p>";
    return;
  }

  renderTable(links);
}

// Render table of links
function renderTable(links) {
  const container = document.getElementById("linksContainer");

  let html = `
    <table>
      <tr>
        <th>Code</th>
        <th>URL</th>
        <th>Clicks</th>
        <th>Last Click</th>
        <th>Actions</th>
      </tr>
  `;

  links.forEach(link => {
    html += `
      <tr>
        <td><a href="/${link.code}" target="_blank">${link.code}</a></td>
        <td class="truncate">${link.url}</td>
        <td>${link.clicks}</td>
        <td>${link.last_clicked ? new Date(link.last_clicked).toLocaleString() : "-"}</td>
        <td>
          <button onclick="copyLink('${link.code}')">Copy</button>
          <button onclick="deleteLink('${link.code}')">Delete</button>
          <a href="/stats/${link.code}">Stats</a>
        </td>
      </tr>
    `;
  });

  html += "</table>";
  container.innerHTML = html;
}

// Copy button
function copyLink(code) {
  const shortUrl = `${window.location.origin}/${code}`;
  navigator.clipboard.writeText(shortUrl);
  alert("Copied: " + shortUrl);
}

// Delete button
async function deleteLink(code) {
  const ok = confirm("Delete this link?");
  if (!ok) return;

  await fetch(`/api/links/${code}`, { method: "DELETE" });
  loadLinks();
}

// Create link form
document.getElementById("createForm").addEventListener("submit", async (e) => {
  e.preventDefault();

  const url = document.getElementById("urlInput").value;
  const code = document.getElementById("codeInput").value;
  const msg = document.getElementById("formMessage");

  const res = await fetch("/api/links", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ url, code })
  });

  const data = await res.json();

  if (!res.ok) {
    msg.textContent = data.error;
    msg.style.color = "red";
  } else {
    msg.textContent = `Created: ${data.code}`;
    msg.style.color = "green";
    loadLinks();
  }
});

// Search filter
document.getElementById("searchInput").addEventListener("input", async (e) => {
  const term = e.target.value.toLowerCase();
  const res = await fetch("/api/links");
  const links = await res.json();

  const filtered = links.filter(l =>
    l.code.toLowerCase().includes(term) ||
    l.url.toLowerCase().includes(term)
  );

  renderTable(filtered);
});

// Initial load
loadLinks();
</script>
